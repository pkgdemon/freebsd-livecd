#!/bin/sh
# rc.local — runs at the end of multi-user boot.
# Used by tests/boot-test.sh to confirm pivot worked and root is writable.

echo ""
echo "================== livecd smoke-test =================="
# `mount | head -1` would show the kernel's first mount (cd9660 at /),
# which is NOT what userland sees as / from inside the init_chroot.
# Filter for the mount that's actually rooted at "/" from our perspective
# -- that's the gunion union device.
echo "rootfs (chroot view) is mounted from:"
mount -p | awk '$2=="/" {print "  device:", $1; print "  type:", $3}'

echo ""
echo "testing write to root..."
if touch /smoke-test 2>/dev/null; then
    rm -f /smoke-test
    echo "WRITE_OK"
else
    echo "WRITE_FAIL"
fi

echo "SMOKE_TEST_DONE"
echo "================== livecd smoke-test =================="
echo ""
